</div>

<!-- ════════════════════════════════
     PANEL: LIVE MAP
════════════════════════════════ -->
<div class="panel" id="panel-map">
  <div class="map-container">
    <div class="map-header">
      <span class="map-title">Live Hazard Map — Tamil Nadu Coastal Waters</span>
      <div class="map-legend">
        <span class="legend-item"><span class="legend-dot" style="background:#e24b4a"></span>Storm/Cyclone</span>
        <span class="legend-item"><span class="legend-dot" style="background:#ef9f27"></span>Oil Spill</span>
        <span class="legend-item"><span class="legend-dot" style="background:#1a6ca8"></span>Rogue Wave</span>
      </div>
    </div>
    <div class="map-body">
      <svg viewBox="0 0 700 380" width="100%" style="border-radius:10px;background:linear-gradient(180deg,#071525 0%,#0a2040 50%,#0d3060 100%)">
        <defs>
          <radialGradient id="gr" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="#e24b4a" stop-opacity="0.6"/><stop offset="100%" stop-color="#e24b4a" stop-opacity="0"/></radialGradient>
          <radialGradient id="go" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="#ef9f27" stop-opacity="0.5"/><stop offset="100%" stop-color="#ef9f27" stop-opacity="0"/></radialGradient>
          <radialGradient id="gb" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="#1a6ca8" stop-opacity="0.6"/><stop offset="100%" stop-color="#1a6ca8" stop-opacity="0"/></radialGradient>
        </defs>
        <!-- Grid -->
        <g stroke="rgba(122,179,212,0.08)" stroke-width="0.5">
          <line x1="0" y1="76"  x2="700" y2="76"/>
          <line x1="0" y1="152" x2="700" y2="152"/>
          <line x1="0" y1="228" x2="700" y2="228"/>
          <line x1="0" y1="304" x2="700" y2="304"/>
          <line x1="140" y1="0" x2="140" y2="380"/>
          <line x1="280" y1="0" x2="280" y2="380"/>
          <line x1="420" y1="0" x2="420" y2="380"/>
          <line x1="560" y1="0" x2="560" y2="380"/>
        </g>
        <!-- Coastline -->
        <path d="M240,10 L228,50 L215,100 L208,150 L204,200 L208,260 L218,320 L230,370" stroke="rgba(122,179,212,0.6)" stroke-width="2.5" fill="none" stroke-linecap="round"/>
        <!-- Land -->
        <path d="M0,0 L240,10 L228,50 L215,100 L208,150 L204,200 L208,260 L218,320 L230,370 L0,370 Z" fill="rgba(12,40,70,0.7)"/>
        <!-- Land labels -->
        <text x="110" y="180" font-size="13" fill="rgba(122,179,212,0.5)" font-family="'Space Mono',monospace" text-anchor="middle">Tamil Nadu</text>
        <text x="110" y="198" font-size="10" fill="rgba(122,179,212,0.3)" font-family="'Space Mono',monospace" text-anchor="middle">India</text>
        <!-- Axis labels -->
        <text x="280" y="14" font-size="9" fill="rgba(122,179,212,0.4)" font-family="'Space Mono',monospace" text-anchor="middle">80°E</text>
        <text x="420" y="14" font-size="9" fill="rgba(122,179,212,0.4)" font-family="'Space Mono',monospace" text-anchor="middle">82°E</text>
        <text x="560" y="14" font-size="9" fill="rgba(122,179,212,0.4)" font-family="'Space Mono',monospace" text-anchor="middle">84°E</text>
        <text x="6" y="80"  font-size="9" fill="rgba(122,179,212,0.4)" font-family="'Space Mono',monospace">13°N</text>
        <text x="6" y="156" font-size="9" fill="rgba(122,179,212,0.4)" font-family="'Space Mono',monospace">12°N</text>
        <text x="6" y="232" font-size="9" fill="rgba(122,179,212,0.4)" font-family="'Space Mono',monospace">11°N</text>
        <text x="6" y="308" font-size="9" fill="rgba(122,179,212,0.4)" font-family="'Space Mono',monospace">10°N</text>
        <!-- HAZARD 1: Cyclone at ~11.4N 80.3E → x~300, y~240 -->
        <circle cx="305" cy="235" r="40" fill="url(#gr)"/>
        <circle cx="305" cy="235" r="14" fill="#e24b4a" opacity="0.95"/>
        <circle cx="305" cy="235" r="22" fill="none" stroke="#e24b4a" stroke-width="1.5" stroke-dasharray="5 4" opacity="0.6">
          <animateTransform attributeName="transform" type="rotate" from="0 305 235" to="360 305 235" dur="8s" repeatCount="indefinite"/>
        </circle>
        <text x="305" y="216" font-size="10" fill="#F09595" font-family="'Space Mono',monospace" text-anchor="middle" font-weight="700">CYCLONE</text>
        <text x="305" y="264" font-size="9"  fill="rgba(240,149,149,0.7)" font-family="'Space Mono',monospace" text-anchor="middle">11.4°N 80.3°E</text>
        <!-- HAZARD 2: Oil Spill at ~10.1N 79.8E → x~285, y~315 -->
        <circle cx="290" cy="318" r="36" fill="url(#go)"/>
        <ellipse cx="290" cy="318" rx="18" ry="10" fill="#ef9f27" opacity="0.85"/>
        <text x="290" y="298" font-size="10" fill="#FAC775" font-family="'Space Mono',monospace" text-anchor="middle" font-weight="700">OIL SPILL</text>
        <text x="290" y="344" font-size="9"  fill="rgba(250,199,117,0.7)" font-family="'Space Mono',monospace" text-anchor="middle">10.1°N 79.8°E</text>
        <!-- HAZARD 3: Rogue Wave at ~9.3N 78.2E → x~235, y~348 -->
        <circle cx="400" cy="345" r="38" fill="url(#gb)"/>
        <circle cx="400" cy="345" r="13" fill="#1a6ca8" opacity="0.95"/>
        <text x="400" y="324" font-size="10" fill="#85B7EB" font-family="'Space Mono',monospace" text-anchor="middle" font-weight="700">ROGUE WAVE</text>
        <text x="400" y="371" font-size="9"  fill="rgba(133,183,235,0.7)" font-family="'Space Mono',monospace" text-anchor="middle">9.3°N 78.2°E</text>
        <!-- Wave decorations -->
        <g stroke="rgba(122,179,212,0.12)" stroke-width="1" fill="none">
          <path d="M250,355 Q265,350 280,355 Q295,360 310,355 Q325,350 340,355 Q355,360 370,355 Q385,350 400,355 Q415,360 430,355 Q445,350 460,355 Q475,360 490,355 Q505,350 520,355"/>
          <path d="M250,368 Q265,363 280,368 Q295,373 310,368 Q325,363 340,368 Q355,373 370,368 Q385,363 400,368 Q415,373 430,368 Q445,363 460,368 Q475,373 490,368 Q505,363 520,368"/>
        </g>
      </svg>
    </div>
  </div>

  <div class="section-title">Active Hazard Zones</div>
  <div class="incident-list">
    <div class="incident-card clickable" onclick="alert('Cyclonic Depression\n\nLocation: 11.4°N, 80.3°E\nRadius: ~40km\nMovement: NNW at 12 knots\nWind Speed: 65 km/h\nStatus: Intensifying\n\nSafety: All fishing vessels advised to return to port immediately.')">
      <div class="incident-icon inc-storm">🌀</div>
      <div class="incident-info">
        <div class="incident-title">Zone 14N — Cyclonic Depression</div>
        <div class="incident-meta">11.4°N, 80.3°E &nbsp;·&nbsp; Radius 40km &nbsp;·&nbsp; Moving NNW @ 12 knots</div>
      </div>
      <span class="incident-sev sev-high">HIGH</span>
    </div>
    <div class="incident-card clickable" onclick="alert('Oil Slick — Palk Strait\n\nLocation: 10.1°N, 79.8°E\nSpread: ~2km surface area\nWind Direction: SSE\nSource: Unknown vessel\n\nRisk: Avoid fishing in zone. Report any vessel in vicinity to Coast Guard.')">
      <div class="incident-icon inc-oil">🛢️</div>
      <div class="incident-info">
        <div class="incident-title">Palk Strait — Oil Slick</div>
        <div class="incident-meta">10.1°N, 79.8°E &nbsp;·&nbsp; Spread ~2km &nbsp;·&nbsp; Wind direction SSE</div>
      </div>
      <span class="incident-sev sev-med">MED</span>
    </div>
    <div class="incident-card clickable" onclick="alert('Rogue Wave Event — Gulf of Mannar\n\nLocation: 9.3°N, 78.2°E\nEstimated Height: 8.2m\nEvent Type: Isolated Rogue Wave\nDuration: ~30 minutes\n\nRisk: High danger to small fishing vessels. Keep clear of zone.')">
      <div class="incident-icon inc-wave">🌊</div>
      <div class="incident-info">
        <div class="incident-title">Gulf of Mannar — Rogue Wave</div>
        <div class="incident-meta">9.3°N, 78.2°E &nbsp;·&nbsp; Height est. 8.2m &nbsp;·&nbsp; Isolated event</div>
      </div>
      <span class="incident-sev sev-high">HIGH</span>
    </div>
  </div>
</div>

<!-- ════════════════════════════════
     PANEL: REPORT HAZARD
════════════════════════════════ -->
<div class="panel" id="panel-report">
  <div class="section-title">Submit a New Hazard Report</div>

  <div style="background:var(--ocean-mid);border:1px solid var(--border-line);border-radius:14px;padding:24px;">
    <div class="form-grid">
      <div class="form-group">
        <label class="form-label">Vessel Name / ID</label>
        <input class="form-input" type="text" placeholder="e.g. TN-FV-2241" id="vessel-id">
      </div>
      <div class="form-group">
        <label class="form-label">Hazard Type</label>
        <select class="form-select" id="hazard-type">
          <option value="">Select hazard type...</option>
          <option>Storm / Cyclone</option>
          <option>Oil Spill / Pollution</option>
          <option>Rogue Wave</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">Latitude</label>
        <input class="form-input" type="text" placeholder="e.g. 11.4200" id="lat-input">
      </div>
      <div class="form-group">
        <label class="form-label">Longitude</label>
        <input class="form-input" type="text" placeholder="e.g. 80.3100" id="lon-input">
      </div>
      <div class="form-group form-full">
        <label class="form-label">Nearest Landmark / Zone</label>
        <input class="form-input" type="text" placeholder="e.g. 12km east of Nagapattinam harbour">
      </div>
      <div class="form-group form-full">
        <label class="form-label">Description</label>
        <textarea class="form-textarea" id="desc-input" placeholder="Describe what you observed — size, intensity, direction of movement, other vessels affected..."></textarea>
      </div>
      <div class="form-group form-full">
        <label class="form-label">Severity Level</label>
        <div class="severity-row">
          <div class="sev-btn" onclick="selectSev(this,'sel-high')">HIGH RISK</div>
          <div class="sev-btn" onclick="selectSev(this,'sel-med')">MODERATE</div>
          <div class="sev-btn" onclick="selectSev(this,'sel-low')">LOW RISK</div>
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Date of Observation</label>
        <input class="form-input" type="date" id="obs-date">
      </div>
      <div class="form-group">
        <label class="form-label">Time of Observation (IST)</label>
        <input class="form-input" type="time" id="obs-time">
      </div>
      <div class="form-group form-full">
        <label class="form-label">Reporter Contact (optional)</label>
        <input class="form-input" type="text" placeholder="Phone number or radio call sign">
      </div>
    </div>
    <button class="submit-btn" onclick="submitReport()">Submit Hazard Report</button>
    <div class="success-msg" id="success-msg">
      ✓ &nbsp; Report submitted successfully! Your report ID is <strong id="report-id"></strong>. Authorities have been notified.
    </div>
  </div>
</div>

<!-- ════════════════════════════════
     PANEL: ANALYTICS
════════════════════════════════ -->
<div class="panel" id="panel-analytics">
  <div class="section-title">Hazard Analytics — Last 30 Days</div>

  <div class="metrics-row">
    <div class="metric">
      <div class="metric-val" style="color:#F09595">38</div>
      <div class="metric-label">Total Reports</div>
      <div class="metric-delta delta-up">▲ +14% vs prior month</div>
    </div>
    <div class="metric">
      <div class="metric-val" style="color:#FAC775">14</div>
      <div class="metric-label">Oil Spill Reports</div>
      <div class="metric-delta delta-up">▲ Most reported type</div>
    </div>
    <div class="metric">
      <div class="metric-val" style="color:#5DCAA5">4.2h</div>
      <div class="metric-label">Avg Response Time</div>
      <div class="metric-delta delta-down">▼ Improved by 1.1h</div>
    </div>
    <div class="metric">
      <div class="metric-val" style="color:#85B7EB">7</div>
      <div class="metric-label">High-Risk Events</div>
      <div class="metric-delta delta-up">▲ +3 vs last month</div>
    </div>
  </div>

  <div class="analytics-grid">
    <!-- Bar chart: Reports by hazard type -->
    <div class="chart-card">
      <div class="chart-card-title">Reports by Hazard Type</div>
      <div class="bar-chart">
        <div class="bar-row">
          <span class="bar-label">Oil Spill</span>
          <div class="bar-track"><div class="bar-fill" id="bar1" style="width:0%;background:#ef9f27"></div></div>
          <span class="bar-val">14</span>
        </div>
        <div class="bar-row">
          <span class="bar-label">Storm/Cyclone</span>
          <div class="bar-track"><div class="bar-fill" id="bar2" style="width:0%;background:#e24b4a"></div></div>
          <span class="bar-val">12</span>
        </div>
        <div class="bar-row">
          <span class="bar-label">Rogue Wave</span>
          <div class="bar-track"><div class="bar-fill" id="bar3" style="width:0%;background:#1a6ca8"></div></div>
          <span class="bar-val">8</span>
        </div>
        <div class="bar-row">
          <span class="bar-label">Other</span>
          <div class="bar-track"><div class="bar-fill" id="bar4" style="width:0%;background:#5DCAA5"></div></div>
          <span class="bar-val">4</span>
        </div>
      </div>
      <div style="margin-top:24px">
        <div class="chart-card-title">Monthly Report Trend</div>
        <div style="position:relative;height:140px">
          <canvas id="trendChart" role="img" aria-label="Monthly ocean hazard report trend over 6 months">Jan 20, Feb 22, Mar 18, Apr 28, May 24, Jun 38</canvas>
        </div>
      </div>
    </div>

    <!-- Donut chart: Severity split -->
    <div class="chart-card">
      <div class="chart-card-title">Severity Distribution</div>
      <div style="position:relative;height:180px">
        <canvas id="donutChart" role="img" aria-label="Severity distribution: High 18%, Medium 37%, Low 45%">High 7, Medium 14, Low 17</canvas>
      </div>
      <div class="donut-legend">
        <div class="donut-legend-row"><span class="donut-dot" style="background:#e24b4a"></span>High Risk &nbsp;&nbsp; 7 reports (18%)</div>
        <div class="donut-legend-row"><span class="donut-dot" style="background:#ef9f27"></span>Medium Risk &nbsp; 14 reports (37%)</div>
        <div class="donut-legend-row"><span class="donut-dot" style="background:#1d9e75"></span>Low Risk &nbsp;&nbsp;&nbsp; 17 reports (45%)</div>
      </div>
    </div>
  </div>

  <div class="analytics-bottom">
    <!-- Reports by zone -->
    <div class="chart-card">
      <div class="chart-card-title">Reports by Coastal Zone</div>
      <div class="bar-chart" style="margin-top:4px">
        <div class="bar-row">
          <span class="bar-label" style="width:110px">Nagapattinam</span>
          <div class="bar-track"><div class="bar-fill" id="zbar1" style="width:0%;background:#1a6ca8"></div></div>
          <span class="bar-val">11</span>
        </div>
        <div class="bar-row">
          <span class="bar-label" style="width:110px">Palk Strait</span>
          <div class="bar-track"><div class="bar-fill" id="zbar2" style="width:0%;background:#1a6ca8"></div></div>
          <span class="bar-val">9</span>
        </div>
        <div class="bar-row">
          <span class="bar-label" style="width:110px">Gulf of Mannar</span>
          <div class="bar-track"><div class="bar-fill" id="zbar3" style="width:0%;background:#1a6ca8"></div></div>
          <span class="bar-val">8</span>
        </div>
        <div class="bar-row">
          <span class="bar-label" style="width:110px">Rameswaram</span>
          <div class="bar-track"><div class="bar-fill" id="zbar4" style="width:0%;background:#1a6ca8"></div></div>
          <span class="bar-val">6</span>
        </div>
        <div class="bar-row">
          <span class="bar-label" style="width:110px">Chennai Coast</span>
          <div class="bar-track"><div class="bar-fill" id="zbar5" style="width:0%;background:#1a6ca8"></div></div>
          <span class="bar-val">4</span>
        </div>
      </div>
    </div>
    <!-- Response time chart -->
    <div class="chart-card">
      <div class="chart-card-title">Response Time by Severity (hrs)</div>
      <div style="position:relative;height:180px">
        <canvas id="responseChart" role="img" aria-label="Average response time by severity: High 1.8h, Medium 4.2h, Low 7.6h">High 1.8h, Medium 4.2h, Low 7.6h</canvas>
      </div>
    </div>
  </div>
</div>

<script>
  // ── Clock ──
  function updateClock() {
    const now = new Date();
    document.getElementById('clock').textContent =
      now.toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit', second: '2-digit', timeZone: 'Asia/Kolkata' }) + ' IST';
  }
  setInterval(updateClock, 1000);
  updateClock();

  // ── Tab switching ──
  function switchTab(id, btn) {
    document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
    document.getElementById('panel-' + id).classList.add('active');
    btn.classList.add('active');
    if (id === 'analytics') initCharts();
  }

  // ── Severity selector ──
  function selectSev(el, cls) {
    document.querySelectorAll('.sev-btn').forEach(b => b.className = 'sev-btn');
    el.classList.add(cls);
  }

  // ── Report submission ──
  function submitReport() {
    const vessel = document.getElementById('vessel-id').value.trim();
    const type   = document.getElementById('hazard-type').value;
    const lat    = document.getElementById('lat-input').value.trim();
    const lon    = document.getElementById('lon-input').value.trim();
    const desc   = document.getElementById('desc-input').value.trim();
    if (!vessel || !type || !lat || !lon || !desc) {
      alert('Please fill in all required fields before submitting.');
      return;
    }
    const id = 'OW-' + Date.now().toString().slice(-6);
    document.getElementById('report-id').textContent = id;
    document.getElementById('success-msg').style.display = 'block';
    document.getElementById('success-msg').scrollIntoView({ behavior: 'smooth' });
    // reset form fields
    ['vessel-id','lat-input','lon-input','desc-input'].forEach(f => document.getElementById(f).value = '');
    document.getElementById('hazard-type').value = '';
    document.querySelectorAll('.sev-btn').forEach(b => b.className = 'sev-btn');
    setTimeout(() => document.getElementById('success-msg').style.display = 'none', 8000);
  }

  // ── Animate bars ──
  function animateBars() {
    const bars = [
      { id:'bar1', w:100 }, { id:'bar2', w:86 }, { id:'bar3', w:57 }, { id:'bar4', w:29 },
      { id:'zbar1', w:100 }, { id:'zbar2', w:82 }, { id:'zbar3', w:73 }, { id:'zbar4', w:55 }, { id:'zbar5', w:36 }
    ];
    bars.forEach(b => {
      const el = document.getElementById(b.id);
      if (el) setTimeout(() => el.style.width = b.w + '%', 100);
    });
  }

  // ── Charts (lazy init) ──
  let chartsInited = false;
  function initCharts() {
    if (chartsInited) return;
    chartsInited = true;
    animateBars();

    // Trend line chart
    new Chart(document.getElementById('trendChart'), {
      type: 'line',
      data: {
        labels: ['Jan','Feb','Mar','Apr','May','Jun'],
        datasets: [{
          label: 'Reports',
          data: [20, 22, 18, 28, 24, 38],
          borderColor: '#1a6ca8',
          backgroundColor: 'rgba(26,108,168,0.12)',
          pointBackgroundColor: '#85B7EB',
          pointRadius: 4,
          fill: true, tension: 0.4
        }]
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          x: { ticks: { color: '#7ab3d4', font: { size: 10 } }, grid: { color: 'rgba(122,179,212,0.08)' } },
          y: { ticks: { color: '#7ab3d4', font: { size: 10 } }, grid: { color: 'rgba(122,179,212,0.08)' } }
        }
      }
    });

    // Donut chart
    new Chart(document.getElementById('donutChart'), {
      type: 'doughnut',
      data: {
        labels: ['High Risk','Medium Risk','Low Risk'],
        datasets: [{
          data: [7, 14, 17],
          backgroundColor: ['#e24b4a','#ef9f27','#1d9e75'],
          borderColor: '#0d2240', borderWidth: 3
        }]
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        cutout: '65%',
        plugins: { legend: { display: false } }
      }
    });

    // Response time bar chart
    new Chart(document.getElementById('responseChart'), {
      type: 'bar',
      data: {
        labels: ['High Risk','Medium Risk','Low Risk'],
        datasets: [{
          label: 'Avg Response (hrs)',
          data: [1.8, 4.2, 7.6],
          backgroundColor: ['rgba(226,75,74,0.7)','rgba(239,159,39,0.7)','rgba(29,158,117,0.7)'],
          borderRadius: 6, borderSkipped: false
        }]
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          x: { ticks: { color: '#7ab3d4', font: { size: 11 } }, grid: { color: 'rgba(122,179,212,0.08)' } },
          y: { ticks: { color: '#7ab3d4', font: { size: 11 } }, grid: { color: 'rgba(122,179,212,0.08)' } }
        }
      }
    });
  }

  // Pre-fill today's date/time on report form
  const now = new Date();
  const pad = n => String(n).padStart(2,'0');
  document.getElementById('obs-date').value = `${now.getFullYear()}-${pad(now.getMonth()+1)}-${pad(now.getDate())}`;
  document.getElementById('obs-time').value = `${pad(now.getHours())}:${pad(now.getMinutes())}`;
</script>
</body>
</html>

