<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>OceanWatch — Hazard Reporting & Analysis Platform</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --ocean-deep: #0a1628;
    --ocean-mid: #0d2240;
    --ocean-surface: #0e3d6e;
    --wave: #1a6ca8;
    --foam: #e8f4fd;
    --danger: #e24b4a;
    --warn: #ef9f27;
    --safe: #1d9e75;
    --text-bright: #e8f4fd;
    --text-muted: #7ab3d4;
    --border-line: rgba(122,179,212,0.2);
  }
  html, body { height: 100%; }
  body {
    background: var(--ocean-deep);
    font-family: 'Syne', sans-serif;
    color: var(--text-bright);
    min-height: 100vh;
  }

  /* ── TOP BAR ── */
  .topbar {
    background: var(--ocean-mid);
    padding: 14px 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--border-line);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .logo { display: flex; align-items: center; gap: 12px; }
  .logo-icon {
    width: 38px; height: 38px;
    background: var(--wave);
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
  }
  .logo-icon svg { width: 22px; height: 22px; fill: white; }
  .logo-text { font-size: 17px; font-weight: 700; letter-spacing: 0.04em; }
  .logo-sub { font-size: 10px; color: var(--text-muted); font-family: 'Space Mono', monospace; letter-spacing: 0.08em; }
  .topbar-right { display: flex; align-items: center; gap: 14px; }
  .badge {
    font-family: 'Space Mono', monospace;
    font-size: 10px; padding: 4px 12px;
    border-radius: 20px; font-weight: 700; letter-spacing: 0.06em;
  }
  .badge-live { background: rgba(29,158,117,0.2); color: #5DCAA5; border: 1px solid rgba(29,158,117,0.4); }
  .badge-warn { background: rgba(239,159,39,0.2); color: #FAC775; border: 1px solid rgba(239,159,39,0.4); }
  .topbar-time { font-family: 'Space Mono', monospace; font-size: 11px; color: var(--text-muted); }

  /* ── NAV ── */
  .nav {
    background: var(--ocean-mid);
    border-bottom: 1px solid var(--border-line);
    display: flex;
    padding: 0 24px;
    gap: 4px;
    position: sticky;
    top: 67px;
    z-index: 99;
  }
  .nav-btn {
    font-family: 'Syne', sans-serif;
    font-size: 13px; font-weight: 500;
    padding: 12px 18px;
    background: none; border: none;
    color: var(--text-muted);
    cursor: pointer;
    border-bottom: 2px solid transparent;
    letter-spacing: 0.04em;
    transition: all 0.2s;
  }
  .nav-btn.active { color: var(--text-bright); border-bottom-color: var(--wave); }
  .nav-btn:hover:not(.active) { color: var(--text-bright); }

  /* ── PANELS ── */
  .panel { display: none; padding: 28px; max-width: 1200px; margin: 0 auto; animation: fadeIn 0.3s ease; }
  .panel.active { display: block; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

  .section-title {
    font-size: 10px; font-weight: 700;
    letter-spacing: 0.14em; color: var(--text-muted);
    text-transform: uppercase; margin-bottom: 14px;
    font-family: 'Space Mono', monospace;
  }

  /* ── METRICS ── */
  .metrics-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 28px; }
  .metric {
    background: var(--ocean-mid);
    border: 1px solid var(--border-line);
    border-radius: 12px; padding: 18px;
  }
  .metric-val { font-size: 30px; font-weight: 700; font-family: 'Space Mono', monospace; line-height: 1; }
  .metric-label { font-size: 12px; color: var(--text-muted); margin-top: 6px; letter-spacing: 0.04em; }
  .metric-delta { font-size: 11px; margin-top: 8px; font-family: 'Space Mono', monospace; }
  .delta-up { color: #e24b4a; }
  .delta-down { color: #1d9e75; }

  /* ── INCIDENT CARDS ── */
  .incident-list { display: flex; flex-direction: column; gap: 10px; }
  .incident-card {
    background: var(--ocean-mid);
    border: 1px solid var(--border-line);
    border-radius: 12px; padding: 14px 18px;
    display: flex; align-items: center; gap: 14px;
    transition: border-color 0.2s;
  }
  .incident-card:hover { border-color: rgba(122,179,212,0.5); }
  .incident-card.clickable { cursor: pointer; }
  .incident-icon {
    width: 42px; height: 42px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; font-size: 20px;
  }
  .inc-storm { background: rgba(226,75,74,0.15); }
  .inc-oil { background: rgba(239,159,39,0.15); }
  .inc-wave { background: rgba(26,108,168,0.15); }
  .incident-info { flex: 1; }
  .incident-title { font-size: 14px; font-weight: 500; margin-bottom: 3px; }
  .incident-meta { font-size: 11px; color: var(--text-muted); font-family: 'Space Mono', monospace; }
  .incident-sev {
    font-size: 11px; font-weight: 700;
    padding: 4px 10px; border-radius: 6px;
    font-family: 'Space Mono', monospace; flex-shrink: 0;
  }
  .sev-high { background: rgba(226,75,74,0.2); color: #F09595; }
  .sev-med  { background: rgba(239,159,39,0.2); color: #FAC775; }
  .sev-low  { background: rgba(29,158,117,0.2); color: #5DCAA5; }

  /* ── MAP ── */
  .map-container {
    background: var(--ocean-mid);
    border: 1px solid var(--border-line);
    border-radius: 14px; overflow: hidden;
    margin-bottom: 20px;
  }
  .map-header {
    padding: 14px 20px;
    border-bottom: 1px solid var(--border-line);
    display: flex; justify-content: space-between; align-items: center;
  }
  .map-title { font-size: 14px; font-weight: 500; }
  .map-legend { display: flex; gap: 16px; }
  .legend-item { display: flex; align-items: center; gap: 6px; font-size: 11px; color: var(--text-muted); font-family: 'Space Mono', monospace; }
  .legend-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
  .map-body { padding: 16px; }

  /* ── FORM ── */
  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .form-full { grid-column: 1 / -1; }
  .form-group { display: flex; flex-direction: column; gap: 7px; }
  .form-label { font-size: 10px; font-weight: 700; letter-spacing: 0.1em; color: var(--text-muted); font-family: 'Space Mono', monospace; }
  .form-input, .form-select, .form-textarea {
    background: var(--ocean-mid);
    border: 1px solid var(--border-line);
    border-radius: 9px; padding: 10px 14px;
    font-size: 13px; color: var(--text-bright);
    font-family: 'Syne', sans-serif; width: 100%;
    outline: none; transition: border-color 0.2s;
  }
  .form-input:focus, .form-select:focus, .form-textarea:focus { border-color: var(--wave); }
  .form-select option { background: var(--ocean-deep); }
  .form-textarea { min-height: 90px; resize: vertical; }
  .severity-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .sev-btn {
    background: var(--ocean-mid);
    border: 1px solid var(--border-line);
    border-radius: 9px; padding: 12px;
    text-align: center; cursor: pointer;
    font-family: 'Space Mono', monospace; font-size: 12px; font-weight: 700;
    transition: all 0.2s; color: var(--text-muted);
  }
  .sev-btn:hover { border-color: var(--wave); color: var(--text-bright); }
  .sev-btn.sel-high { background: rgba(226,75,74,0.2); border-color: #e24b4a; color: #F09595; }
  .sev-btn.sel-med  { background: rgba(239,159,39,0.2); border-color: #ef9f27; color: #FAC775; }
  .sev-btn.sel-low  { background: rgba(29,158,117,0.2); border-color: #1d9e75; color: #5DCAA5; }
  .submit-btn {
    background: var(--wave); border: none;
    border-radius: 9px; padding: 14px 28px;
    color: white; font-family: 'Syne', sans-serif;
    font-size: 14px; font-weight: 700; cursor: pointer;
    width: 100%; margin-top: 8px;
    letter-spacing: 0.04em; transition: opacity 0.2s;
  }
  .submit-btn:hover { opacity: 0.85; }
  .success-msg {
    background: rgba(29,158,117,0.15);
    border: 1px solid rgba(29,158,117,0.4);
    border-radius: 10px; padding: 16px;
    text-align: center; font-size: 14px;
    color: #5DCAA5; display: none; margin-top: 12px;
  }

  /* ── ANALYTICS ── */
  .analytics-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 16px; margin-bottom: 20px; }
  .chart-card {
    background: var(--ocean-mid);
    border: 1px solid var(--border-line);
    border-radius: 14px; padding: 20px;
  }
  .chart-card-title {
    font-size: 11px; font-weight: 700;
    letter-spacing: 0.1em; color: var(--text-muted);
    font-family: 'Space Mono', monospace; margin-bottom: 16px;
  }
  .bar-chart { display: flex; flex-direction: column; gap: 10px; }
  .bar-row { display: flex; align-items: center; gap: 12px; }
  .bar-label { font-size: 11px; color: var(--text-muted); width: 90px; flex-shrink: 0; font-family: 'Space Mono', monospace; }
  .bar-track { flex: 1; background: rgba(122,179,212,0.1); border-radius: 4px; height: 12px; overflow: hidden; }
  .bar-fill { height: 100%; border-radius: 4px; transition: width 1.2s cubic-bezier(0.4,0,0.2,1); }
  .bar-val { font-size: 11px; font-family: 'Space Mono', monospace; color: var(--text-muted); width: 30px; text-align: right; }
  .donut-legend { display: flex; flex-direction: column; gap: 8px; margin-top: 12px; }
  .donut-legend-row { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--text-muted); font-family: 'Space Mono', monospace; }
  .donut-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
  .analytics-bottom { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }

  @media (max-width: 768px) {
    .metrics-row { grid-template-columns: repeat(2, 1fr); }
    .analytics-grid { grid-template-columns: 1fr; }
    .analytics-bottom { grid-template-columns: 1fr; }
    .form-grid { grid-template-columns: 1fr; }
    .form-full { grid-column: 1; }
    .nav-btn { padding: 10px 12px; font-size: 11px; }
    .topbar { padding: 12px 16px; }
    .panel { padding: 16px; }
  }
</style>
</head>
<body>

<!-- TOP BAR -->
<div class="topbar">
  <div class="logo">
    <div class="logo-icon">
      <svg viewBox="0 0 24 24"><path d="M3 18c3-4 6-6 9-6s6 2 9 6H3zm0-6c2-3 5-5 9-5s7 2 9 5H3z"/></svg>
    </div>
    <div>
      <div class="logo-text">OceanWatch</div>
      <div class="logo-sub">Hazard Reporting &amp; Analysis Platform</div>
    </div>
  </div>
  <div class="topbar-right">
    <span class="badge badge-live">● LIVE</span>
    <span class="badge badge-warn">3 ACTIVE ALERTS</span>
    <span class="topbar-time" id="clock"></span>
  </div>
</div>

<!-- NAV -->
<div class="nav">
  <button class="nav-btn active" onclick="switchTab('dashboard', this)">Dashboard</button>
  <button class="nav-btn" onclick="switchTab('map', this)">Live Map</button>
  <button class="nav-btn" onclick="switchTab('report', this)">Report Hazard</button>
  <button class="nav-btn" onclick="switchTab('analytics', this)">Analytics</button>
</div>

<!-- ════════════════════════════════
     PANEL: DASHBOARD
════════════════════════════════ -->
